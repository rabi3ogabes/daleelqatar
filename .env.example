# ---------------------------------------------------------------------------
# Daleel Qatar | دليل قطر — environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------
APP_NAME="Daleel Qatar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Qatar

# Arabic is the default language; English lives under /en
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=ar,en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL (Laravel native pgsql driver)
# Supabase Dashboard → Project Settings → Database → Connection string.
# Use the DIRECT connection (db.<ref>.supabase.co:5432) or the SESSION
# pooler (aws-0-<region>.pooler.supabase.com:5432). If you must use the
# TRANSACTION pooler (port 6543) set DB_EMULATE_PREPARES=true.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Isolated application schema (keeps Daleel tables out of the PostgREST-exposed
# "public" schema). "extensions" holds pg_trgm on Supabase.
DB_SEARCH_PATH=daleel,extensions,public
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=daleel

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# File storage — Supabase Storage
# MEDIA_DISK=supabase  → uploads go to Supabase Storage (production)
# MEDIA_DISK=public    → uploads go to storage/app/public (local development)
# The SERVICE ROLE key is SERVER-SIDE ONLY. It is never sent to browsers or
# returned by the API.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
MEDIA_DISK=public
PRIVATE_MEDIA_DISK=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=daleel-public
SUPABASE_PRIVATE_BUCKET=daleel-private
SUPABASE_SIGNED_URL_TTL=600

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@daleelqatar.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — first-party SPA domains (mobile apps use bearer tokens instead)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1:8000
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Security headers
SECURITY_HSTS=false
SECURITY_CSP=true

# Vercel Cron Jobs authenticate to /cron/maintenance with this bearer token.
# Leave empty on servers that run `php artisan schedule:run` instead.
CRON_SECRET=

# Optional: create the first super administrator with `php artisan daleel:create-admin`

VITE_APP_NAME="${APP_NAME}"
